{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegym.dev/schemas/problem-quality/report.v2.json",
  "title": "ProblemQualityReport",
  "type": "object",
  "required": [
    "report_version",
    "run_id",
    "started_at",
    "completed_at",
    "tested_commit",
    "baseline_kind",
    "runtime_config",
    "generation_config",
    "summary",
    "cases",
    "recommendations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tested_commit": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string"
    },
    "prompt_revision": {
      "type": "string"
    },
    "model_revision": {
      "type": "string"
    },
    "baseline_kind": {
      "type": "string",
      "enum": [
        "independent",
        "current",
        "agent-built",
        "other"
      ]
    },
    "runtime_config": {
      "type": "object"
    },
    "generation_config": {
      "type": "object"
    },
    "cost_cap_usd": {
      "type": "number",
      "minimum": 0
    },
    "total_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "total_tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "preliminary": {
      "type": "boolean",
      "default": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "blind_agreement_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "reconciliation_frequency": {
          "type": [
            "number",
            "string"
          ]
        },
        "non_convergence_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "correct_alternative_acceptance_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "wrong_solution_rejection_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "discrimination_score": {
          "type": [
            "number",
            "string"
          ]
        },
        "ambiguous_specification_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "generation_failures": {
          "type": "integer",
          "minimum": 0
        },
        "setup_failures": {
          "type": "integer",
          "minimum": 0
        },
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "cases_passed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_failed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_error": {
          "type": "integer",
          "minimum": 0
        },
        "cases_not_run": {
          "type": "integer",
          "minimum": 0
        },
        "development_fixture_cases": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_cases": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_eligibility_cases": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      },
      "additionalProperties": false,
      "required": [
        "metrics"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "technology",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "not_run"
            ]
          },
          "generation": {
            "type": "object",
            "properties": {
              "reconciliation_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reconciliation_direction": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "reference",
                  "tests",
                  "both",
                  null
                ]
              },
              "non_convergence": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "measured",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "first_attempt_agreement": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Observed agreement between the first generation attempt and the accepted reference. Expected outcomes are never copied here."
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "unavailable_reason": {
                "type": "string",
                "minLength": 1
              },
              "generation_failed": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Explicit historical generation-failure observation. Null means unavailable; it is never inferred from disagreement or non-convergence."
              },
              "generation_failure_details": {
                "type": "string",
                "minLength": 1,
                "description": "Recorded details for an explicit historical generation failure."
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": [
              "generation_during_assessment",
              "saved_exercise_provenance",
              "model_revision",
              "model_revision_status",
              "prompt_revision",
              "prompt_revision_status"
            ],
            "properties": {
              "generation_during_assessment": {
                "type": "boolean"
              },
              "saved_exercise_provenance": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "model_revision": {
                "type": "string"
              },
              "model_revision_status": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "prompt_revision": {
                "type": "string"
              },
              "prompt_revision_status": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "generation_config": {
                "type": "object"
              },
              "saved_exercise_usage": {
                "$ref": "#/$defs/generationUsage"
              },
              "assessment_run_usage": {
                "$ref": "#/$defs/generationUsage"
              }
            },
            "additionalProperties": false
          },
          "content_identity": {
            "type": "object",
            "required": [
              "algorithm",
              "case_definition",
              "specification",
              "run_config",
              "reference",
              "correct_alternatives",
              "wrong_solutions",
              "artifact"
            ],
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "case_definition": {
                "$ref": "#/$defs/contentFile"
              },
              "specification": {
                "$ref": "#/$defs/contentFile"
              },
              "run_config": {
                "$ref": "#/$defs/contentFile"
              },
              "reference": {
                "$ref": "#/$defs/solutionContent"
              },
              "correct_alternatives": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solutionContent"
                }
              },
              "wrong_solutions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solutionContent"
                }
              },
              "artifact": {
                "type": "object",
                "required": [
                  "files",
                  "sha256"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/contentFile"
                    }
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "correct_alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "accepted"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "accepted": {
                  "type": "boolean"
                },
                "failure": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "execution_status": {
                  "type": "string"
                },
                "failure_category": {
                  "type": "string"
                },
                "diagnostic_code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer"
                },
                "elapsed_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "review_status": {
                  "type": "string"
                },
                "reviewed_by": {
                  "type": "string"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "reviewed_reference": {
                  "type": "string"
                },
                "required_test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "test_id",
                      "passed"
                    ],
                    "properties": {
                      "test_id": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "failure_class": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "assertion": {
                        "type": "object",
                        "required": [
                          "code",
                          "expected",
                          "actual"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "expected": {
                            "type": "string"
                          },
                          "actual": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "output_tail": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "wrong_solutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rejected"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "rejected": {
                  "type": "boolean"
                },
                "intended_failure_matched": {
                  "type": "boolean"
                },
                "surviving": {
                  "type": "boolean"
                },
                "failure": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "execution_status": {
                  "type": "string"
                },
                "failure_category": {
                  "type": "string"
                },
                "diagnostic_code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer"
                },
                "elapsed_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "review_status": {
                  "type": "string"
                },
                "reviewed_by": {
                  "type": "string"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "reviewed_reference": {
                  "type": "string"
                },
                "required_test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "test_id",
                      "passed"
                    ],
                    "properties": {
                      "test_id": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "failure_class": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "assertion": {
                        "type": "object",
                        "required": [
                          "code",
                          "expected",
                          "actual"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "expected": {
                            "type": "string"
                          },
                          "actual": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "output_tail": {
                  "type": "string"
                },
                "denominator_decision": {
                  "type": "string"
                },
                "excluded": {
                  "type": "boolean"
                },
                "intended_failure": {
                  "type": "object",
                  "properties": {
                    "test_id": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "actual": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "comparator_config": {
            "type": "string"
          },
          "comparator_result": {
            "type": "string"
          },
          "ambiguous_spec": {
            "type": "boolean"
          },
          "failure_category": {
            "type": "string"
          },
          "failure_details": {
            "type": "string"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "tokens_in": {
            "type": "integer",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "minimum": 0
          },
          "corpus_version": {
            "type": "string"
          },
          "development_fixture": {
            "type": "boolean"
          },
          "excluded_from_reviewed_totals": {
            "type": "boolean"
          },
          "artifact": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "manifest_path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "required": [
              "id",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string"
              },
              "reviewed_reference": {
                "type": "string"
              },
              "review_status": {
                "type": "string"
              },
              "artifact_id": {
                "type": "string"
              },
              "artifact_version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "required_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "boolean"
          },
          "block_reason": {
            "type": "string"
          },
          "benchmark_eligible": {
            "type": "boolean"
          },
          "benchmark_eligibility": {
            "type": "string"
          },
          "benchmark_eligibility_reason": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "run_config": {
            "type": "string"
          },
          "reference_outcome": {
            "type": "object",
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "accepted": {
                "type": "boolean"
              },
              "failure": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "execution_status": {
                "type": "string"
              },
              "failure_category": {
                "type": "string"
              },
              "diagnostic_code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "elapsed_ms": {
                "type": "integer",
                "minimum": 0
              },
              "review_status": {
                "type": "string"
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string"
              },
              "reviewed_reference": {
                "type": "string"
              },
              "required_test_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "test_id",
                    "passed"
                  ],
                  "properties": {
                    "test_id": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "failure_class": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "assertion": {
                      "type": "object",
                      "required": [
                        "code",
                        "expected",
                        "actual"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "actual": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "output_tail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "ambiguous_spec_recorded": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tested_dirty": {
      "type": "boolean"
    },
    "development_fixture": {
      "type": "boolean"
    },
    "corpus": {
      "type": "object",
      "required": [
        "root",
        "selection"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "selected_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "local",
        "sandbox",
        "model_operations",
        "paid_operations"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "local": {
          "type": "boolean"
        },
        "sandbox": {
          "type": "boolean"
        },
        "model_operations": {
          "type": "boolean"
        },
        "paid_operations": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "report_version": {
      "type": "string",
      "const": "2.0.0",
      "description": "Problem-quality report format version. Bump when required report fields or metric semantics change."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "budget": {
      "type": "object",
      "required": [
        "currency",
        "limit_micros",
        "prior_spend_micros",
        "reserved_micros",
        "settled_micros",
        "committed_micros",
        "remaining_micros",
        "reservations"
      ],
      "properties": {
        "currency": {
          "type": "string"
        },
        "limit_micros": {
          "type": "integer",
          "minimum": 0
        },
        "prior_spend_micros": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_micros": {
          "type": "integer",
          "minimum": 0
        },
        "settled_micros": {
          "type": "integer",
          "minimum": 0
        },
        "committed_micros": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_micros": {
          "type": "integer",
          "minimum": 0
        },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "operation_id",
              "max_cost_micros",
              "status"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "max_cost_micros": {
                "type": "integer",
                "minimum": 0
              },
              "actual_cost_micros": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "reserved",
                  "unknown",
                  "settled"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "generationUsage": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unavailable",
            "not_applicable"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micros": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "USD"
          ]
        },
        "cost_status": {
          "type": "string",
          "enum": [
            "provider_reported",
            "estimated"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "pricing_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contentFile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "solutionContent": {
      "type": "object",
      "required": [
        "id",
        "files",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentFile"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "status",
        "definition",
        "numerator",
        "denominator",
        "excluded"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "unavailable",
            "not_applicable"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "exclusion_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "correct_alternative_acceptance",
        "wrong_solution_rejection",
        "discrimination_score",
        "ambiguous_specification_rate",
        "first_attempt_agreement",
        "reconciliation_frequency",
        "non_convergence_rate",
        "cases"
      ],
      "properties": {
        "correct_alternative_acceptance": {
          "$ref": "#/$defs/metric"
        },
        "wrong_solution_rejection": {
          "$ref": "#/$defs/metric"
        },
        "discrimination_score": {
          "$ref": "#/$defs/metric"
        },
        "ambiguous_specification_rate": {
          "$ref": "#/$defs/metric"
        },
        "first_attempt_agreement": {
          "$ref": "#/$defs/metric"
        },
        "reconciliation_frequency": {
          "$ref": "#/$defs/metric"
        },
        "non_convergence_rate": {
          "$ref": "#/$defs/metric"
        },
        "reconciliation_directions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cases": {
          "$ref": "#/$defs/metricCaseBasis"
        }
      },
      "additionalProperties": false
    },
    "metricCaseBasis": {
      "type": "object",
      "required": [
        "total",
        "eligible",
        "development_fixtures_excluded",
        "unresolved_eligibility_excluded",
        "observed_generation_cases"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "development_fixtures_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_eligibility_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "observed_generation_cases": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "followUp": {
      "type": "object",
      "required": [
        "action",
        "owner"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "findingEvidence": {
      "type": "object",
      "required": [
        "source",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "case_id",
        "kind",
        "summary",
        "cause_established",
        "follow_ups"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "surviving_wrong_solution",
            "setup_failure",
            "case_not_run",
            "ambiguous_specification",
            "generation_failure",
            "first_attempt_disagreement",
            "reconciliation",
            "non_convergence"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "assessment_quality",
            "historical_generation"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_identity_status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "artifact_identity_unavailable_reason": {
          "type": "string",
          "minLength": 1
        },
        "quality_metric_treatment": {
          "type": "string",
          "enum": [
            "included",
            "excluded",
            "not_applicable"
          ]
        },
        "quality_metric_treatment_reason": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "solution_id": {
          "type": "string"
        },
        "test_id": {
          "type": "string"
        },
        "assertion_code": {
          "type": "string"
        },
        "comparator_context": {
          "type": "string"
        },
        "hypothesis": {
          "type": "string"
        },
        "cause_established": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/findingEvidence"
          }
        },
        "review_action": {
          "type": "string"
        },
        "follow_ups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/followUp"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
