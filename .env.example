# CodeGym Configuration

# Server
CODEGYM_PORT=8080
CODEGYM_HOST=0.0.0.0

# Database
CODEGYM_DB_PATH=./data/codegym.db

# Problems directory
CODEGYM_PROBLEMS_DIR=./problems

# JWT secret (generate with: openssl rand -hex 32)
CODEGYM_JWT_SECRET=change-me-in-production

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Docker
CODEGYM_MAX_CONCURRENT_EXECUTIONS=4
CODEGYM_DEFAULT_TIMEOUT_SECONDS=30
CODEGYM_DEFAULT_MEMORY_MB=256
