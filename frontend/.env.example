# API base path. Defaults to /api/v1 (same-origin) when unset.
#   - Local dev: vite.config.ts proxies /api -> http://localhost:8080.
#   - Vercel: vercel.json rewrites /api/* -> the Render backend, so the
#     default same-origin path also works and needs no override there.
# Only set an absolute URL (e.g. https://codegym.onrender.com/api/v1) when you
# deliberately want the browser to call the backend cross-origin instead.
VITE_API_BASE_URL=/api/v1

# Mock API proxy. Only active in `vite dev` (import.meta.env.DEV); production
# builds ignore it. Set false to hit a real backend during local dev.
VITE_USE_MOCK_API=true

# Auth0 Single Page Application values. Leave DOMAIN/CLIENT_ID empty to run
# without Auth0: the client falls back to a localStorage `codegym_token`
# bearer token (pairs with the backend dev authenticator).
VITE_AUTH0_DOMAIN=dev-qpevrkauua3p7j6l.us.auth0.com
VITE_AUTH0_CLIENT_ID=Z4LdZf8STLjtuUvkrdgrtGvwzwQlJbBZ

# Auth0 API Identifier. Set this after creating the CodeGym API in Auth0.
VITE_AUTH0_AUDIENCE=
