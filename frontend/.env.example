# API base path. Local Vite development can use /api/v1 through its localhost
# proxy. Deployed builds must set the absolute URL of their matching backend.
VITE_API_BASE_URL=/api/v1

# Mock API proxy. Only active in `vite dev` (import.meta.env.DEV); production
# builds ignore it. Keep false for the real Daytona demo; set true only for
# isolated fixture development.
VITE_USE_MOCK_API=false

# Auth0 Single Page Application values. Leave DOMAIN/CLIENT_ID empty to run
# without Auth0: the client falls back to a localStorage `codegym_token`
# bearer token (pairs with the backend dev authenticator).
VITE_AUTH0_DOMAIN=dev-qpevrkauua3p7j6l.us.auth0.com
VITE_AUTH0_CLIENT_ID=Z4LdZf8STLjtuUvkrdgrtGvwzwQlJbBZ

# Auth0 API Identifier. Set this after creating the CodeGym API in Auth0.
VITE_AUTH0_AUDIENCE=

# Canonical frontend origin used for Auth0 callback and logout URLs. Deployed
# Preview builds must use their stable branch alias, not an ephemeral deployment
# URL. Leave empty locally to use the current browser origin.
VITE_APP_ORIGIN=
