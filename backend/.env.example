# Runtime isolation identity. Must be exactly dev, stg, or prd. It defaults to
# dev and falls back to Doppler's injected config/environment metadata.
CODEGYM_ENVIRONMENT=dev

NEON_CONNECTION_STRING=

# Auth0 backend API token validation.
# Set CODEGYM_AUTH_MODE=auth0 to require Auth0 config at startup.
CODEGYM_AUTH_MODE=
CODEGYM_AUTH0_DOMAIN=
CODEGYM_AUTH0_ISSUER_URL=
CODEGYM_AUTH0_AUDIENCE=
CODEGYM_AUTH0_CLOCK_SKEW=

# Local protected-route fallback when Auth0 is not configured.
CODEGYM_DEV_AUTH_TOKEN=
CODEGYM_DEV_USER_ID=dev-user
CODEGYM_DEV_WORKSPACE_ID=personal-dev
CODEGYM_HOST=127.0.0.1
CODEGYM_PORT=8080
CODEGYM_CORS_ALLOWED_ORIGINS=
CODEGYM_MEMORY_WORKER_DISABLED=false
CODEGYM_MEMORY_WORKER_INTERVAL=24h
CODEGYM_MEMORY_REFRESH_TRIGGER=both
CODEGYM_SEED_DEMO=false

# Isolated code execution. The demo coding flow requires both values in
# production; DAYTONA_API_URL may be left empty when using Daytona's default.
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Multi-provider GenAI (OpenAI-compatible chat completions).
# Priority default: meta, azure, gemini. Providers without a key are skipped.
# Leave all keys empty to disable POST /api/v1/generate (returns 503).
CODEGYM_GENAI_PROVIDER_ORDER=meta,azure,gemini

# Meta Muse Spark (https://api.meta.ai/v1) — prefer credit-backed Meta first.
CODEGYM_GENAI_META_API_KEY=
# META_MUSE_SPARK_API=   # alias for CODEGYM_GENAI_META_API_KEY
CODEGYM_GENAI_META_BASE_URL=https://api.meta.ai/v1
CODEGYM_GENAI_META_MODEL=muse-spark-1.1
CODEGYM_GENAI_META_MAX_TOKENS=4096

# Azure OpenAI — full deployment base URL + api-key header.
CODEGYM_GENAI_AZURE_API_KEY=
CODEGYM_GENAI_AZURE_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
CODEGYM_GENAI_AZURE_MODEL=
CODEGYM_GENAI_AZURE_API_VERSION=2024-10-21-preview

# Gemini (last resort / pay-as-you-go). Omit from PROVIDER_ORDER to park.
CODEGYM_GEMINI_API_KEY=
CODEGYM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CODEGYM_GEMINI_MODEL=gemini-flash-latest
