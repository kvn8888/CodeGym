{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "codegym-relay/spike-model",
  "provider": {
    "codegym-relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CodeGym local isolation recorder",
      "options": {
        "baseURL": "http://127.0.0.1:50620/v1",
        "apiKey": "sk-isolation-not-a-real-key"
      },
      "models": {
        "spike-model": {
          "name": "Isolation spike model",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "tests-isolated": {
      "description": "Generate tests from the shared spec without reading reference artifacts",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "bash": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": {
          "*": "deny",
          "test_solution.py": "allow",
          "spec/spec.md": "allow",
          "../spec/spec.md": "allow"
        },
        "external_directory": {
          "*": "deny",
          "/private/tmp/opencode-isolation-62722/tree/spec/*": "allow"
        }
      }
    }
  }
}
