import importlib
import json
import math
import time

PREFIX = "CODEGYM_RESULT "


def emit(tests, compile_error=None):
    print(PREFIX + json.dumps(
        {"tests": tests, "compile_error": compile_error},
        separators=(",", ":"),
    ))


def equal(actual, expected):
    return actual == expected


def unordered_list(actual, expected):
    return sorted(actual) == sorted(expected)


def set_equal(actual, expected):
    return set(actual) == set(expected)


def float_approx(actual, expected):
    return math.isclose(actual, expected, rel_tol=1e-9, abs_tol=1e-9)


def any_of(actual, expected):
    return any(actual == candidate for candidate in expected)


COMPARATORS = {
    "equal": equal,
    "unordered_list": unordered_list,
    "set_equal": set_equal,
    "float_approx": float_approx,
    "any_of": any_of,
}

CASES = json.loads({{.CasesJSON}})

try:
    solution = importlib.import_module("{{.Module}}")
    target = getattr(solution, "{{.EntryPoint}}")
except Exception as exc:
    emit([], f"{type(exc).__name__}: {exc}")
    raise SystemExit(0)


results = []
for case in CASES:
    started = time.perf_counter()
    error = None
    status = "pass"
    try:
        actual = target(*case["args"])
        compare = COMPARATORS[case["compare"]]
        if not compare(actual, case["expected"]):
            status = "fail"
            error = f"expected {case['expected']!r}, got {actual!r}"
    except Exception as exc:
        status = "fail"
        error = f"{type(exc).__name__}: {exc}"
    duration_ms = max(0, int((time.perf_counter() - started) * 1000))
    results.append({
        "name": case["name"],
        "status": status,
        "duration_ms": duration_ms,
        "error": error,
    })

emit(results)
