{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegym.dev/schemas/problem-quality/report.v1.json",
  "title": "ProblemQualityReport",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "completed_at",
    "tested_commit",
    "baseline_kind",
    "runtime_config",
    "generation_config",
    "summary",
    "cases",
    "recommendations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tested_commit": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string"
    },
    "prompt_revision": {
      "type": "string"
    },
    "model_revision": {
      "type": "string"
    },
    "baseline_kind": {
      "type": "string",
      "enum": [
        "independent",
        "current",
        "agent-built",
        "other"
      ]
    },
    "runtime_config": {
      "type": "object"
    },
    "generation_config": {
      "type": "object"
    },
    "cost_cap_usd": {
      "type": "number",
      "minimum": 0
    },
    "total_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "total_tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "preliminary": {
      "type": "boolean",
      "default": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "blind_agreement_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "reconciliation_frequency": {
          "type": [
            "number",
            "string"
          ]
        },
        "non_convergence_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "correct_alternative_acceptance_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "wrong_solution_rejection_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "discrimination_score": {
          "type": [
            "number",
            "string"
          ]
        },
        "ambiguous_specification_rate": {
          "type": [
            "number",
            "string"
          ]
        },
        "generation_failures": {
          "type": "integer",
          "minimum": 0
        },
        "setup_failures": {
          "type": "integer",
          "minimum": 0
        },
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "cases_passed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_failed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_error": {
          "type": "integer",
          "minimum": 0
        },
        "cases_not_run": {
          "type": "integer",
          "minimum": 0
        },
        "development_fixture_cases": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_cases": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_eligibility_cases": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "technology",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "not_run"
            ]
          },
          "generation": {
            "type": "object",
            "properties": {
              "blind_agreement": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reconciliation_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reconciliation_direction": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "reference",
                  "tests",
                  "both",
                  null
                ]
              },
              "non_convergence": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "measured",
                  "not_applicable"
                ]
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": [
              "generation_during_assessment",
              "saved_exercise_provenance",
              "model_revision",
              "model_revision_status",
              "prompt_revision",
              "prompt_revision_status"
            ],
            "properties": {
              "generation_during_assessment": {
                "type": "boolean"
              },
              "saved_exercise_provenance": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "model_revision": {
                "type": "string"
              },
              "model_revision_status": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "prompt_revision": {
                "type": "string"
              },
              "prompt_revision_status": {
                "type": "string",
                "enum": [
                  "known",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "generation_config": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "content_identity": {
            "type": "object",
            "required": [
              "algorithm",
              "case_definition",
              "specification",
              "run_config",
              "reference",
              "correct_alternatives",
              "wrong_solutions",
              "artifact"
            ],
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "case_definition": {
                "$ref": "#/$defs/contentFile"
              },
              "specification": {
                "$ref": "#/$defs/contentFile"
              },
              "run_config": {
                "$ref": "#/$defs/contentFile"
              },
              "reference": {
                "$ref": "#/$defs/solutionContent"
              },
              "correct_alternatives": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solutionContent"
                }
              },
              "wrong_solutions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/solutionContent"
                }
              },
              "artifact": {
                "type": "object",
                "required": [
                  "files",
                  "sha256"
                ],
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/contentFile"
                    }
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "correct_alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "accepted"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "accepted": {
                  "type": "boolean"
                },
                "failure": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "execution_status": {
                  "type": "string"
                },
                "failure_category": {
                  "type": "string"
                },
                "diagnostic_code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer"
                },
                "elapsed_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "review_status": {
                  "type": "string"
                },
                "reviewed_by": {
                  "type": "string"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "reviewed_reference": {
                  "type": "string"
                },
                "required_test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "test_id",
                      "passed"
                    ],
                    "properties": {
                      "test_id": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "failure_class": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "assertion": {
                        "type": "object",
                        "required": [
                          "code",
                          "expected",
                          "actual"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "expected": {
                            "type": "string"
                          },
                          "actual": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "output_tail": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "wrong_solutions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rejected"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "rejected": {
                  "type": "boolean"
                },
                "intended_failure_matched": {
                  "type": "boolean"
                },
                "surviving": {
                  "type": "boolean"
                },
                "failure": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "execution_status": {
                  "type": "string"
                },
                "failure_category": {
                  "type": "string"
                },
                "diagnostic_code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer"
                },
                "elapsed_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "review_status": {
                  "type": "string"
                },
                "reviewed_by": {
                  "type": "string"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "reviewed_reference": {
                  "type": "string"
                },
                "required_test_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "test_id",
                      "passed"
                    ],
                    "properties": {
                      "test_id": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "failure_class": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      },
                      "assertion": {
                        "type": "object",
                        "required": [
                          "code",
                          "expected",
                          "actual"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "expected": {
                            "type": "string"
                          },
                          "actual": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "output_tail": {
                  "type": "string"
                },
                "denominator_decision": {
                  "type": "string"
                },
                "excluded": {
                  "type": "boolean"
                },
                "intended_failure": {
                  "type": "object",
                  "properties": {
                    "test_id": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "actual": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "comparator_config": {
            "type": "string"
          },
          "comparator_result": {
            "type": "string"
          },
          "ambiguous_spec": {
            "type": "boolean"
          },
          "failure_category": {
            "type": "string"
          },
          "failure_details": {
            "type": "string"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "tokens_in": {
            "type": "integer",
            "minimum": 0
          },
          "tokens_out": {
            "type": "integer",
            "minimum": 0
          },
          "corpus_version": {
            "type": "string"
          },
          "development_fixture": {
            "type": "boolean"
          },
          "excluded_from_reviewed_totals": {
            "type": "boolean"
          },
          "artifact": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "manifest_path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "required": [
              "id",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string"
              },
              "reviewed_reference": {
                "type": "string"
              },
              "review_status": {
                "type": "string"
              },
              "artifact_id": {
                "type": "string"
              },
              "artifact_version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "required_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "boolean"
          },
          "block_reason": {
            "type": "string"
          },
          "benchmark_eligible": {
            "type": "boolean"
          },
          "benchmark_eligibility": {
            "type": "string"
          },
          "benchmark_eligibility_reason": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "run_config": {
            "type": "string"
          },
          "reference_outcome": {
            "type": "object",
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "accepted": {
                "type": "boolean"
              },
              "failure": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "execution_status": {
                "type": "string"
              },
              "failure_category": {
                "type": "string"
              },
              "diagnostic_code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "elapsed_ms": {
                "type": "integer",
                "minimum": 0
              },
              "review_status": {
                "type": "string"
              },
              "reviewed_by": {
                "type": "string"
              },
              "reviewed_at": {
                "type": "string"
              },
              "reviewed_reference": {
                "type": "string"
              },
              "required_test_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "test_id",
                    "passed"
                  ],
                  "properties": {
                    "test_id": {
                      "type": "string"
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "failure_class": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "assertion": {
                      "type": "object",
                      "required": [
                        "code",
                        "expected",
                        "actual"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "actual": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "output_tail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tested_dirty": {
      "type": "boolean"
    },
    "development_fixture": {
      "type": "boolean"
    },
    "corpus": {
      "type": "object",
      "required": [
        "root",
        "selection"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "selection": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "selected_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "local",
        "sandbox",
        "model_operations",
        "paid_operations"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "local": {
          "type": "boolean"
        },
        "sandbox": {
          "type": "boolean"
        },
        "model_operations": {
          "type": "boolean"
        },
        "paid_operations": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contentFile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "solutionContent": {
      "type": "object",
      "required": [
        "id",
        "files",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentFile"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
